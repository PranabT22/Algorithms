    else:
         print(f"Comparison {comparison_count} returned {number}\nElement Checked:{index}")

# Question 7 

# Given the array
# [4, 6, 4, 6, 4, 6, 4, 6, 4, 6, 4, 6]
# Perform a linear search for 6.
# Show all comparisons until the search stops and state the index returned.

numbers = [4, 6, 4, 6, 4, 6, 4, 6, 4, 6, 4, 6]
comparison_count = 0
for index, number in enumerate(numbers):
    comparison_count += 1
    if number == 6:
        print(f"{number} found in Index:{index}")
    else:
         print(f"Comparison {comparison_count} returned {number}\nElement Checked:{index}")

            
