# Question 1 
# Given the array
# [4, 8, 6, 2]
# Perform a linear search to find the value 4.
# State the index where the value is found.

numbers = [4, 8,6,2]
for index, number in enumerate(numbers):
  if number == 4:
  	print(f"Found {number} in:\nIndex found:{index}")


# Question 2
# Given the array
# [10, 20, 30, 40]
# Perform a linear search for 30.
# How many comparisons are made before the value is found?

numbers = [10,20,30,40]
for index, number in enumerate(numbers):
  if number == 30:
  	print(f"Found {number}:\nComparison made before finding value found:{index}")


# Question 3 

# Given the array
# [5, 3, 7, 1, 9]
# Perform a linear search for 1.
# List the elements checked in order and state the index where the value is found.

numbers = [5,3,7,1,9]
for index, number in enumerate(numbers):
  if number == 1:
  	print(f"{number} found in Index:{index}")
  else:
    print(f"Number not found in Index:{index}")
   

# Question 4 

# Given the array
# [2, 4, 6, 8, 10]
# Perform a linear search for 10.
# State:
# the elements checked
# the total number of comparisons made

numbers = [2, 4, 6, 8, 10]
comparison_count = 0
for index, number in enumerate(numbers):
    comparison_count += 1
    print(f"Element Checked: {number}")
    if number == 10:
        print(f"{number} found at index {index}")
        break
print(f"Total comparisons made: {comparison_count}")


# Question 5 

# Given the array
# [7, 14, 21, 28, 35]
# Perform a linear search for 21.
# Show each comparison and state the index returned.

numbers = [7, 14, 21, 28, 35]
comparison_count = 0
for index, number in enumerate(numbers):
    comparison_count += 1
    if number == 21:
        print(f"{number} found in Index:{comparison_count}")
        break
    else:
         print(f"Comparison {comparison_count} returned {number}\nElement Checked:{index}")
            
# Question 6 

# Given the array
