    if number == 9:
        print(f"{number} found in Index:{index}")
    else:
         print(f"Comparison {comparison_count} returned {number}\nElement Checked:{index}")
            
# Question 9

# Given the array
# [3, 6, 9, 12, 15, 18, 21, 24]
# Perform a linear search for 21.
# You must:

# show each comparison in order

# state the index returned
numbers = [3, 6, 9, 12, 15, 18, 21, 24]
comparison_count = 0
for index, number in enumerate(numbers):
    comparison_count += 1
    if number == 21:
        print(f"{number} found in Index:{index}")
        break
    else:
         print(f"Comparison {comparison_count} returned {number}\nElement Checked:{index}")
            
